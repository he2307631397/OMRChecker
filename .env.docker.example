# Copy this file to .env.docker before running docker compose.
# The service listens on port 8088 inside the container and on the host.

# Robyn service settings
OMR_SERVICE_PORT=8088
OMR_SERVICE_HOST=0.0.0.0
OMR_SERVICE_WORKERS=auto
OMR_SERVICE_DATA_DIR=/app/service_data
OMR_TEMPLATE_DIR=/app/inputs
OMR_RECOGNITION_DEBUG_ARTIFACTS=false

# Optional callback target for COS batch terminal callbacks.
# OMR_CALLBACK_URL=https://java.example.com/omr/batch-callback

# Tencent COS credentials used by config/robyn-service.json placeholders.
# Leave COS disabled in config/robyn-service.json for local mock-COS mode.
COS_SECRET_ID=
COS_SECRET_KEY=
