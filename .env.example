# Copy to .env and fill deployment-specific values.

# Host port exposed by Docker Compose. The container always listens on 8080.
OMR_SERVICE_PORT=8080

# Recognition worker count. Use auto to match container CPU count, or set an integer.
OMR_SERVICE_WORKERS=auto

# Optional callback URL override. If empty, config/robyn-service.json callback.url is used.
OMR_CALLBACK_URL=

# Tencent COS credentials, consumed by config/robyn-service.json or environment overrides.
COS_SECRET_ID=
COS_SECRET_KEY=

# Preserve per-sheet working files for debugging. Keep false in production.
OMR_RECOGNITION_DEBUG_ARTIFACTS=false
