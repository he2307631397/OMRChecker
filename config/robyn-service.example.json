{
  "server": {
    "port": 8080,
    "workers": 1
  },
  "storage": {
    "serviceDataDir": "service_data",
    "templateDir": "inputs",
    "archivePrefix": "omr-archive"
  },
  "database": {
    "url": "sqlite:///service_data/omr_service.db"
  },
  "cos": {
    "enabled": true,
    "region": "ap-guangzhou",
    "bucket": "example-bucket-1250000000",
    "secretId": "${COS_SECRET_ID}",
    "secretKey": "${COS_SECRET_KEY}"
  },
  "callback": {
    "maxAttempts": 3,
    "timeoutSeconds": 10
  },
  "archiveRegions": [
    {
      "regionCode": "candidateNumber",
      "regionName": "准考证号区域",
      "type": "DIGIT",
      "bbox": [0, 0, 100, 40]
    },
    {
      "regionCode": "singleChoice",
      "regionName": "单选题区域",
      "type": "SINGLE_CHOICE",
      "bbox": [0, 50, 300, 500]
    },
    {
      "regionCode": "multiChoice",
      "regionName": "多选题区域",
      "type": "MULTI_CHOICE",
      "bbox": [0, 560, 300, 900]
    }
  ]
}
