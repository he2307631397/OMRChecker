{
  "server": {
    "port": 8080,
    "workers": "auto"
  },
  "storage": {
    "serviceDataDir": "service_data",
    "templateDir": "inputs",
    "archivePrefix": "omr-archive"
  },
  "database": {
    "url": "sqlite:///service_data/omr_service.db"
  },
  "cos": {
    "enabled": true,
    "region": "ap-guangzhou",
    "bucket": "example-bucket-1250000000",
    "secretId": "${COS_SECRET_ID}",
    "secretKey": "${COS_SECRET_KEY}"
  },
  "callback": {
    "url": "https://java.example.com/omr/batch-callback",
    "maxAttempts": 3,
    "timeoutSeconds": 10
  }
}
